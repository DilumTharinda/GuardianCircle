{
  "expo": {
    "name": "GuardianCircle",
    "slug": "guardiancircle",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "android": {
      "package": "com.guardiancircle.app",
      "versionCode": 1
    },
    "ios": {
      "bundleIdentifier": "com.guardiancircle.app",
      "deploymentTarget": "15.1"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 34,
            "targetSdkVersion": 34
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-font"
    ]
  }
}
