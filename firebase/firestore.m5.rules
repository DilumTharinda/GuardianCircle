// M5 reference rules. Merge with the reviewed rules for other modules before deployment.
// Do not retain broad authenticated-user or wildcard allows over these paths.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function role(uid) { return get(/databases/$(database)/documents/users/$(uid)).data.role; }
    function parent() { return verified() && role(request.auth.uid) == 'parent_guardian'; }
    function child() { return verified() && role(request.auth.uid) == 'child_dependent'; }
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role in ['primary_user', 'parent_guardian', 'child_dependent', 'pet_owner', 'trusted_contact'];
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'role']);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    function linkedParent(childUid) {
      let link = get(/databases/$(database)/documents/m5Links/$(request.auth.uid + '_' + childUid)).data;
      return parent() && link.ownerUid == request.auth.uid && link.targetUid == childUid && link.status == 'active';
    }
    match /m5Locations/{childUid} {
      allow get: if (child() && request.auth.uid == childUid) || linkedParent(childUid);
      allow create, update: if child() && request.auth.uid == childUid
        && request.resource.data.keys().hasOnly(['latitude','longitude','accuracy','speed','address','updatedAt','sosActive','sosTimestamp','lastCheckIn','checkInNote'])
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.get('latitude', null) == null && request.resource.data.get('longitude', null) == null)
          || (request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90
            && request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180))
        && (request.resource.data.get('accuracy', null) == null || (request.resource.data.accuracy is number && request.resource.data.accuracy >= 0))
        && (request.resource.data.get('speed', null) == null || request.resource.data.speed is number)
        && request.resource.data.get('address', '') is string && request.resource.data.get('address', '').size() <= 500
        && request.resource.data.get('checkInNote', '') is string && request.resource.data.get('checkInNote', '').size() <= 200
        && request.resource.data.get('sosActive', false) is bool;
    }
    match /m5Items/{itemId} {
      allow create: if parent() && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if parent() && resource.data.ownerUid == request.auth.uid;
    }
    match /m5Links/{linkId} {
      function participant() { return verified() && (resource.data.ownerUid == request.auth.uid || resource.data.targetUid == request.auth.uid); }
      function validRequest() {
        let data = request.resource.data;
        return parent() && data.ownerUid == request.auth.uid && data.targetUid != request.auth.uid
          && role(data.targetUid) == 'child_dependent'
          && linkId == data.ownerUid + '_' + data.targetUid
          && data.keys().hasOnly(['ownerUid','ownerName','targetUid','targetName','type','status','safeZones','createdAt','updatedAt'])
          && data.type == 'child' && data.status == 'pending' && data.safeZones == []
          && data.ownerName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
          && data.targetName == 'Child' && data.createdAt == request.time && data.updatedAt == request.time;
      }
      allow get: if participant() || (parent() && !exists(/databases/$(database)/documents/m5Links/$(linkId)));
      allow list: if participant();
      allow create: if validRequest();
      allow update: if
        (participant() && resource.data.status in ['rejected','revoked'] && validRequest())
        || (child() && resource.data.targetUid == request.auth.uid && resource.data.status == 'pending'
          && request.resource.data.status in ['active','rejected']
          && request.resource.data.targetName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','targetName','updatedAt']));
      allow update: if participant() && resource.data.status == 'active'
        && request.resource.data.updatedAt == request.time
        && ((parent() && resource.data.ownerUid == request.auth.uid
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && request.resource.data.status == 'revoked')
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['safeZones','updatedAt']) && request.resource.data.safeZones is list && request.resource.data.safeZones.size() <= 20)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkInRequested','updatedAt']) && request.resource.data.checkInRequested == true)))
          || (child() && resource.data.targetUid == request.auth.uid
            && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkInRequested','updatedAt']) && request.resource.data.checkInRequested == false)
              || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && request.resource.data.status == 'revoked'))));
      match /events/{eventId} {
        function link() { return get(/databases/$(database)/documents/m5Links/$(linkId)).data; }
        allow read: if verified() && link().status == 'active' && (link().ownerUid == request.auth.uid || link().targetUid == request.auth.uid);
        allow create: if child() && link().status == 'active' && link().targetUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['title','category','description','createdAt','actorUid'])
          && request.resource.data.actorUid == request.auth.uid && request.resource.data.createdAt == request.time;
        allow delete: if parent() && link().status == 'active' && link().ownerUid == request.auth.uid;
      }
    }
  }
}
